{
  "name": "re-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm ci --prefix dashboard && npm run build --prefix dashboard",
    "preview": "vite preview",
    "worker": "npm run build && wrangler dev",
    "data": "node scripts/build-transit.mjs; node scripts/build-places.mjs; node scripts/build-schools.mjs; node scripts/build-lots.mjs; node scripts/build-dining.mjs",
    "test": "npm ci --prefix server && npm test --prefix server",
    "build:legacy": "tsc --noEmit && tsc --noEmit -p worker && vite build"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.14.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pbf": "^5.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
