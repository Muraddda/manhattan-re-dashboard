// Cloudflare Worker: static app from ./dist plus /api/data/* snapshots in KV, refreshed daily by the cron.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manhattan-re-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "DATA", "id": "c68bbf424d9e4ed78442726ab0ac1750" }],
  // 09:23 UTC = ~5 am New York (EDT; 4 am in winter).
  "triggers": { "crons": ["23 9 * * *"] },
  "observability": { "enabled": true }
}
