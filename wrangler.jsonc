// Cloudflare Worker: static app from ./dist plus /api/data/* snapshots in KV, refreshed daily by the cron.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manhattan-re-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "DATA", "id": "c68bbf424d9e4ed78442726ab0ac1750" }],
  // No cron trigger: the Workers Free plan allows 5 per account. Snapshots refresh on the first request after they turn
  // 24 h old (see worker/index.ts). On a paid plan you can add: "triggers": { "crons": ["23 9 * * *"] }
  "observability": { "enabled": true }
}
