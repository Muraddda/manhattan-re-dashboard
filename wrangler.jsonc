// Cloudflare Worker manhattan-re-dashboard: rental-matching API (server/) + dashboard static assets (dashboard/dist).
// Deployed by Workers Builds on push to main: `npm run build` then `npx wrangler deploy` from the repo root.
// Legacy Skyline config is preserved at tag legacy-skyline-backup.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manhattan-re-dashboard",
  "main": "server/src/index.ts",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rental-poc-preview-db",
      "database_id": "b067e99c-0183-43c4-aa7a-c2bfdd795c4e",
      "migrations_dir": "server/migrations"
    }
  ],
  "vars": {
    "VERSION": "v1-demo",
    "BROKERAGE_ID": "brk_demo",
    "TURNSTILE_ENABLED": "false"
  },
  "observability": { "enabled": true }
}
